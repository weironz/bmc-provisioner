{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BMC Fleet Console",
  "version": "0.1.11",
  "identifier": "io.bmc-provisioner.desktop",
  "build": {
    "beforeDevCommand": "bun run service:build && bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BMC Fleet Console",
        "width": 1080,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/weironz/bmc-provisioner/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5QTEzODlDMERGQTZDQjQKUldTMGJQb05uRGloYWNEOVBpQ05YL3k0dVg3eGF3Yi94UW8wWGFBM1loK0JBdWVYMU1WMW0wUVMK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "裸金属 BMC 舰队管理控制台",
    "longDescription": "按集群纳管裸金属服务器 BMC，并通过 Redfish 完成批量电源控制、基础硬件监控与网络配置。",
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/bmc-provisionerd"],
    "createUpdaterArtifacts": true
  }
}
